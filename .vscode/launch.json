{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WinUI App (unpackaged)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:app",
      "program": "${workspaceFolder}/src/BookCtl.App/bin/Debug/net10.0-windows10.0.19041.0/win-x64/BookCtl.App.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONUTF8": "1", "BOOKCTL_ENGINE": "mock" }
    },
    {
      "name": "CLI attach",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/BookCtl.Cli/bin/Debug/net10.0/BookCtl.Cli.exe",
      "args": ["capabilities"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
