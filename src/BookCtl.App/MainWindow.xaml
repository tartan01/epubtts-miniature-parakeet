<Window
    x:Class="BookCtl.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" Background="#F5F5F7"
          AllowDrop="True"
          DragOver="Root_DragOver" Drop="Root_Drop" DragLeave="Root_DragLeave">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：产品名 + 模式切换 -->
        <Grid Grid.Row="0" Padding="40,20" Background="#F5F5F7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="10" Background="#0071E3">
                    <TextBlock Text="朗" FontSize="17" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="本地朗读工厂" FontSize="17" FontWeight="SemiBold" Foreground="#1D1D1F" />
                    <TextBlock Text="EPUB · 分章节有声书 · 全程本地" FontSize="12" Foreground="#86868B" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2" Background="White" CornerRadius="999" Padding="4"
                    BorderBrush="#E8E8ED" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton Content="简洁模式" CornerRadius="999" Padding="18,8" FontSize="14"
                                  IsChecked="{Binding IsSimpleMode, Mode=TwoWay}" />
                    <ToggleButton Content="详细参数" CornerRadius="999" Padding="18,8" FontSize="14"
                                  IsChecked="{Binding IsDetailedMode, Mode=TwoWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="40,8,40,40">
            <StackPanel MaxWidth="1080" Spacing="24" HorizontalAlignment="Center">

                <!-- 标题区：每屏只讲一件事 -->
                <StackPanel Spacing="10" Margin="0,16,0,8">
                    <TextBlock Text="{Binding ModeTitle}" FontSize="40" FontWeight="SemiBold"
                               Foreground="#1D1D1F" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ModeSubtitle}" FontSize="17" Foreground="#86868B" TextWrapping="Wrap" />
                </StackPanel>

                <!-- ===================== 简洁模式 ===================== -->
                <StackPanel Visibility="{Binding SimpleVisibility}" Spacing="24">

                    <Border Background="White" CornerRadius="24" Padding="32"
                            BorderBrush="#E8E8ED" BorderThickness="1">
                        <StackPanel Spacing="20">
                            <StackPanel Spacing="6">
                                <TextBlock Text="导入电子书" FontSize="12" Foreground="#86868B" CharacterSpacing="60" />
                                <TextBlock Text="把 .epub 从桌面或文件夹直接拖进窗口，也可以点「浏览…」" FontSize="14" Foreground="#1D1D1F" TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding InputPath, Mode=OneWay}" IsReadOnly="True"
                                         PlaceholderText="拖入 .epub，或点「浏览…」" CornerRadius="12" Padding="16,12" FontSize="15"
                                         Background="#F5F5F7" BorderThickness="0" />
                                <Button Grid.Column="1" Content="浏览…" Click="Pick_Click" CornerRadius="999"
                                        Padding="22,12" FontSize="15" Background="White" BorderBrush="#D2D2D7"
                                        BorderThickness="1" Foreground="#1D1D1F" />
                            </Grid>

                            <Button Content="生成朗读音频" HorizontalAlignment="Stretch" Height="52" FontSize="17"
                                    FontWeight="SemiBold" CornerRadius="999" Foreground="White" Background="#0071E3"
                                    Click="StartSimple_Click" IsEnabled="{Binding CanStart}" />

                            <TextBlock Text="{Binding HintText}" FontSize="13" Foreground="#86868B" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 实时进度 -->
                    <Border Background="White" CornerRadius="24" Padding="32"
                            BorderBrush="#E8E8ED" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <Grid>
                                <TextBlock Text="{Binding PhaseText}" FontSize="17" FontWeight="SemiBold" Foreground="#1D1D1F" />
                                <TextBlock Text="{Binding EtaText}" FontSize="13" Foreground="#86868B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="6"
                                         Foreground="#0071E3" Background="#EDEDF0" CornerRadius="3" />
                            <Grid>
                                <TextBlock Text="{Binding ProgressText}" FontSize="13" Foreground="#86868B" />
                                <TextBlock Text="{Binding SpeedText}" FontSize="13" Foreground="#86868B" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 生成结果：文件夹 + 章节 -->
                    <Border Background="White" CornerRadius="24" Padding="32"
                            BorderBrush="#E8E8ED" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <Grid>
                                <TextBlock Text="生成结果" FontSize="24" FontWeight="SemiBold" Foreground="#1D1D1F" />
                                <TextBlock Text="{Binding ChapterSummary}" FontSize="13" Foreground="#86868B"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Border Background="#F5F5F7" CornerRadius="12" Padding="16,14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="输出文件夹" FontSize="12" Foreground="#86868B" />
                                        <TextBlock Text="{Binding OutputFolder}" FontSize="13" Foreground="#1D1D1F"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="打开" Click="OpenOutput_Click" CornerRadius="999"
                                            Padding="20,8" FontSize="14" Background="White" BorderBrush="#D2D2D7"
                                            BorderThickness="1" Foreground="#0071E3" IsEnabled="{Binding CanOpenOutput}" />
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Chapters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFF" BorderBrush="#EDEDF0" BorderThickness="1"
                                                CornerRadius="12" Padding="16,12" Margin="0,0,0,8">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="74" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="13" Foreground="#86868B" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontSize="15" Foreground="#1D1D1F" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="#86868B" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Duration}" FontSize="13" Foreground="#86868B" />
                                                    <Border Background="#E8F8EC" CornerRadius="999" Padding="10,3">
                                                        <TextBlock Text="{Binding Badge}" FontSize="12" Foreground="#1E8E3E" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="取消当前任务" Click="Cancel_Click" CornerRadius="999" Padding="20,9"
                                        FontSize="14" Background="White" BorderBrush="#D2D2D7" BorderThickness="1"
                                        Foreground="#1D1D1F" IsEnabled="{Binding Busy}" />
                                <TextBlock Text="{Binding SourceStatus}" FontSize="12" Foreground="#86868B"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== 详细参数模式 ===================== -->
                <Grid Visibility="{Binding DetailedVisibility}" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：参数 -->
                    <Border Grid.Column="0" Background="White" CornerRadius="24" Padding="28"
                            BorderBrush="#E8E8ED" BorderThickness="1" VerticalAlignment="Top">
                        <StackPanel Spacing="18">
                            <TextBlock Text="输入 · 支持从桌面直接拖入 .epub" FontSize="12" Foreground="#86868B" CharacterSpacing="60" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding InputPath, Mode=OneWay}" IsReadOnly="True"
                                         PlaceholderText="拖入 .epub，或点「浏览」" CornerRadius="12" Padding="14,10"
                                         Background="#F5F5F7" BorderThickness="0" FontSize="13" />
                                <Button Grid.Column="1" Content="浏览" Click="Pick_Click" CornerRadius="999"
                                        Padding="18,9" FontSize="13" Background="White" BorderBrush="#D2D2D7"
                                        BorderThickness="1" />
                            </Grid>

                            <TextBlock Text="引擎与设备" FontSize="12" Foreground="#86868B" CharacterSpacing="60" Margin="0,6,0,0" />
                            <ComboBox Header="TTS 引擎" HorizontalAlignment="Stretch" CornerRadius="12"
                                      ItemsSource="{Binding Engines}" SelectedItem="{Binding Engine, Mode=TwoWay}" />
                            <ComboBox Header="音色" HorizontalAlignment="Stretch" CornerRadius="12"
                                      ItemsSource="{Binding Voices}" SelectedItem="{Binding Voice, Mode=TwoWay}" />
                            <ComboBox Header="推理设备" HorizontalAlignment="Stretch" CornerRadius="12"
                                      ItemsSource="{Binding DeviceModes}" SelectedItem="{Binding DeviceMode, Mode=TwoWay}" />
                            <ComboBox Header="显卡" HorizontalAlignment="Stretch" CornerRadius="12"
                                      ItemsSource="{Binding Devices}" SelectedIndex="{Binding DeviceIndex, Mode=TwoWay}" />
                            <TextBox Header="CPU 线程数（留空=自动）" Text="{Binding CpuThreads, Mode=TwoWay}"
                                     CornerRadius="12" PlaceholderText="自动" />

                            <Border Background="#F5F5F7" CornerRadius="12" Padding="14,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding PlanText}" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PlanHint}" FontSize="12" Foreground="#86868B" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="输出" FontSize="12" Foreground="#86868B" CharacterSpacing="60" Margin="0,6,0,0" />
                            <TextBox Header="语速（0.5 – 2.0）" Text="{Binding Speed, Mode=TwoWay}" CornerRadius="12" />
                            <CheckBox Content="同时生成整本 M4B（带章节标记）" IsChecked="{Binding GenerateM4B, Mode=TwoWay}" />

                            <Button Content="开始生成" HorizontalAlignment="Stretch" Height="48" FontSize="16"
                                    FontWeight="SemiBold" CornerRadius="999" Foreground="White" Background="#0071E3"
                                    Click="StartDetailed_Click" IsEnabled="{Binding CanStart}" />
                            <Button Content="取消任务" HorizontalAlignment="Stretch" CornerRadius="999" Padding="18,10"
                                    FontSize="14" Background="White" BorderBrush="#D2D2D7" BorderThickness="1"
                                    Click="Cancel_Click" IsEnabled="{Binding Busy}" />
                        </StackPanel>
                    </Border>

                    <!-- 右：状态 + 中控台 -->
                    <StackPanel Grid.Column="1" Spacing="20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="24" Padding="24"
                                    BorderBrush="#E8E8ED" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="当前阶段" FontSize="12" Foreground="#86868B" />
                                    <TextBlock Text="{Binding PhaseText}" FontSize="15" FontWeight="SemiBold" Foreground="#1D1D1F" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="White" CornerRadius="24" Padding="24"
                                    BorderBrush="#E8E8ED" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="推理设备" FontSize="12" Foreground="#86868B" />
                                    <TextBlock Text="{Binding GpuText}" FontSize="15" FontWeight="SemiBold" Foreground="#1D1D1F" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="White" CornerRadius="24" Padding="24"
                                BorderBrush="#E8E8ED" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="{Binding ProgressText}" FontSize="13" Foreground="#1D1D1F" />
                                    <TextBlock Text="{Binding SpeedText}" FontSize="13" Foreground="#86868B" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="6"
                                             Foreground="#0071E3" Background="#EDEDF0" CornerRadius="3" />
                                <TextBlock Text="{Binding HintText}" FontSize="12" Foreground="#86868B" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="24" Padding="24"
                                BorderBrush="#E8E8ED" BorderThickness="1" MinHeight="240">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="中控台 · 实时事件" FontSize="15" FontWeight="SemiBold" Foreground="#1D1D1F" VerticalAlignment="Center" />
                                    <Button Content="清空" Click="ClearLogs_Click" HorizontalAlignment="Right" CornerRadius="999"
                                            Padding="16,6" FontSize="12" Background="White" BorderBrush="#D2D2D7" BorderThickness="1" />
                                </Grid>
                                <ListView Grid.Row="1" ItemsSource="{Binding Logs}" SelectionMode="None" MaxHeight="320">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="10" Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas" FontSize="11" Foreground="#86868B" />
                                                <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="11" Foreground="#0071E3" />
                                                <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="11" Foreground="#1D1D1F" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 底栏 -->
        <Border Grid.Row="2" Background="#F5F5F7" BorderBrush="#E8E8ED" BorderThickness="0,1,0,0" Padding="40,12">
            <Grid>
                <TextBlock Text="{Binding WorkspaceText}" FontSize="11" Foreground="#86868B" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FooterText}" FontSize="11" Foreground="#86868B" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- 拖放提示层：覆盖全窗口。IsHitTestVisible=False 保证它不拦截拖放事件，
             否则 DragLeave/Drop 会因命中目标变化而抖动。 -->
        <Border x:Name="DropOverlay" Grid.RowSpan="3" Visibility="Collapsed"
                Background="#CCF0F7FF" IsHitTestVisible="False">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="420"
                    Background="White" CornerRadius="28" Padding="56,40"
                    BorderBrush="#0071E3" BorderThickness="2">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="↓" FontSize="54" Foreground="#0071E3" HorizontalAlignment="Center" />
                    <TextBlock Text="松开即可导入 EPUB" FontSize="26" FontWeight="SemiBold"
                               Foreground="#1D1D1F" HorizontalAlignment="Center" />
                    <TextBlock Text="简洁模式 / 详细参数模式均可直接拖入" FontSize="14"
                               Foreground="#86868B" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
