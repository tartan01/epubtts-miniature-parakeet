<Application
    x:Class="BookCtl.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Apple 风格：唯一强调色 #0071e3（覆盖系统 accent，让 ToggleButton / ProgressBar 同步） -->
            <Color x:Key="SystemAccentColor">#0071E3</Color>
            <Color x:Key="SystemAccentColorLight1">#0077ED</Color>
            <Color x:Key="SystemAccentColorLight2">#3D9BF0</Color>
            <Color x:Key="SystemAccentColorLight3">#6FB4F5</Color>
            <Color x:Key="SystemAccentColorDark1">#0062C4</Color>
            <Color x:Key="SystemAccentColorDark2">#0055AC</Color>
            <Color x:Key="SystemAccentColorDark3">#004794</Color>

            <!-- 全局字体：Win11 的 Segoe UI Variable 是 SF Pro 最接近的系统替代 -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
